rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cambiar también NEXT_PUBLIC_INSTITUTIONAL_DOMAIN si se confirma otro dominio.
    function institutional() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ucsm[.]edu[.]pe');
    }
    function owner(uid) { return institutional() && request.auth.uid == uid; }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['favorites', 'alerts', 'threshold', 'routeId', 'habitualPointId'])
        && d.favorites is list && d.favorites.size() <= 100
        && d.alerts is bool && d.threshold in [3, 5, 10]
        && d.routeId in ['norte', 'sur', 'este', 'oeste']
        && d.habitualPointId is string && d.habitualPointId.matches(d.routeId + '-[0-9]+');
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validProfile();
      allow delete: if owner(uid);
      match /devices/{deviceId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string && request.resource.data.token == deviceId
          && request.resource.data.token.size() < 2048 && request.resource.data.createdAt is number;
      }
      match /notifications/{notificationId} {
        allow read: if owner(uid);
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }
    match /routes/{routeId} { allow read: if institutional(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
